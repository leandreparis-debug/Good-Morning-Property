# Copy to .env.local and fill in. Never commit real values.
# Every variable is validated at startup by src/lib/env.ts (Zod): a missing one stops the app.
# Adding a required variable? Update src/lib/env.ts, this file AND .github/workflows/ci.yml.

# Public URL of the app: base of the personal links (<APP_URL>/l/<token>).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase, LOCAL stack only (`pnpm db:start`, Docker) -------------------------
# API URL of the local stack (fixed port, see supabase/config.toml).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Local keys: printed by `pnpm db:env` (or `pnpm db:status`) once the stack runs.
# They only work against your local stack. Never put a hosted project's key here.
# Public "anon" key (subject to RLS):
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# "service_role" key — server only, BYPASSES RLS. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# The app sends no email: there is no SMTP configuration.
