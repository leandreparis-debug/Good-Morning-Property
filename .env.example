# Copy to .env.local and fill in. Never commit real values.
# Every variable is validated at startup by src/lib/env.ts (Zod).

# Public URL of the app (used in magic links and reminder emails from step 3 on).
NEXT_PUBLIC_APP_URL=http://localhost:3000

